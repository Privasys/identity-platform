{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Single source of truth for canonical user attributes and provider claim mappings. Used by both the Go IdP and the TypeScript wallet/SDK. Attribute keys follow OIDC Standard Claims (RFC 7519 §5.1). 'verifiable' = can reach 'provider' assurance (an OIDC claim like email_verified); 'identityVerifiable' = can reach 'gov' assurance via the identity-verifier enclave (passport/ID + biometric). 'multiValued' = the wallet may hold more than one value (e.g. several emails); on import a differing value is added alongside rather than treated as a conflict. Assurance levels: none < provider < gov (see kyc-enclave-design.md §3). The 'identity' scope is request-gated so gov attributes are never pulled by an ordinary 'profile' request.",
  "$marketplaceComment": "'marketplace' is present on exactly those attributes the attribute marketplace can issue as a paid disclosure, and exists so that no component reconstructs the namespaced key by hand. 'key' is the '<namespace>:<name>' form the IdP requests, the voucher names and a billing grant must match verbatim: a reservation resolves attributes by namespace and refuses a bare name, so the two spellings are not interchangeable. 'assurance' repeats the registry's own vocabulary ('gov_verified', or 'self_asserted' by default) rather than the none/provider/gov ladder above, because it is compared against values that come back from the control plane. 'billable' says a disclosure carries a charge at all; the PRICE is deliberately absent. The registry (management-service migrations 055/056, table 'attributes') stays authoritative for price, status and for third-party namespaces, which this file cannot know about — read the live catalogue when the price or the full provider list matters. Absence of the block means the attribute is self-asserted or profile-sourced and is never billed.",
  "attributes": [
    { "key": "email",        "label": "Email",         "scope": "email",    "profileField": "email",       "verifiable": true,  "multiValued": true },
    { "key": "name",         "label": "Display Name",  "scope": "profile",  "profileField": "displayName", "verifiable": false },
    { "key": "given_name",   "label": "First Name",    "scope": "profile",  "profileField": null,          "verifiable": false, "identityVerifiable": true, "marketplace": { "key": "privasys:given_name",  "assurance": "gov_verified", "billable": true } },
    { "key": "family_name",  "label": "Last Name",     "scope": "profile",  "profileField": null,          "verifiable": false, "identityVerifiable": true, "marketplace": { "key": "privasys:family_name", "assurance": "gov_verified", "billable": true } },
    { "key": "nickname",     "label": "Nickname",      "scope": "profile",  "profileField": null,          "verifiable": false },
    { "key": "picture",      "label": "Avatar",        "scope": "profile",  "profileField": "avatarUri",   "verifiable": false },
    { "key": "locale",       "label": "Language",      "scope": "profile",  "profileField": "locale",      "verifiable": false, "valuesUrl": "/referential/locale.json", "deviceSourced": true },
    { "key": "phone_number", "label": "Phone Number",  "scope": "phone",    "profileField": null,          "verifiable": true,  "multiValued": true },
    { "key": "birthdate",    "label": "Date of Birth", "scope": "identity", "profileField": null,          "verifiable": false, "identityVerifiable": true, "marketplace": { "key": "privasys:birthdate",   "assurance": "gov_verified", "billable": true } },
    { "key": "nationality",  "label": "Nationality",   "scope": "identity", "profileField": null,          "verifiable": false, "identityVerifiable": true, "valuesUrl": "/referential/nationality.json", "marketplace": { "key": "privasys:nationality", "assurance": "gov_verified", "billable": true } },
    { "key": "age_over_18",  "label": "18 or older",   "scope": "identity", "profileField": null,          "verifiable": false, "identityVerifiable": true, "marketplace": { "key": "privasys:age_over_18", "assurance": "gov_verified", "billable": true } },
    { "key": "age_over_21",  "label": "21 or older",   "scope": "identity", "profileField": null,          "verifiable": false, "identityVerifiable": true, "marketplace": { "key": "privasys:age_over_21", "assurance": "gov_verified", "billable": true } },
    { "key": "document_number", "label": "Passport Number", "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "document_type",   "label": "Document Type",   "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "sex",             "label": "Sex",             "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "issuing_state",   "label": "Issuing Country", "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true, "valuesUrl": "/referential/nationality.json" },
    { "key": "doc_expiry",      "label": "Passport Expiry", "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "place_of_birth",  "label": "Place of Birth",  "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "personal_number", "label": "Personal Number", "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "given_name_id",   "label": "Given Names (ID)","scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "family_name_id",  "label": "Surname (ID)",    "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true },
    { "key": "picture_id",      "label": "Photo (ID)",      "scope": "identity", "profileField": null,       "verifiable": false, "identityVerifiable": true }
  ],
  "providers": {
    "google": {
      "claimMap": {
        "sub":         "sub",
        "name":        "name",
        "given_name":  "given_name",
        "family_name": "family_name",
        "picture":     "picture",
        "email":       "email",
        "locale":      "locale"
      },
      "idClaim": "sub",
      "verificationClaims": {
        "email": "email_verified",
        "phone_number": "phone_number_verified"
      }
    },
    "microsoft": {
      "claimMap": {
        "sub":               "sub",
        "name":              "name",
        "displayName":       "name",
        "given_name":        "given_name",
        "givenName":         "given_name",
        "family_name":       "family_name",
        "surname":           "family_name",
        "picture":           "picture",
        "email":             "email",
        "mail":              "email",
        "userPrincipalName": "email",
        "locale":            "locale",
        "preferredLanguage": "locale"
      },
      "idClaim": "sub",
      "verificationClaims": {
        "email": "email_verified"
      }
    },
    "github": {
      "claimMap": {
        "id":         "sub",
        "name":       "name",
        "login":      "name",
        "avatar_url": "picture",
        "email":      "email"
      },
      "idClaim": "id",
      "verificationClaims": {
        "email": "_always_verified"
      }
    },
    "linkedin": {
      "claimMap": {
        "sub":         "sub",
        "name":        "name",
        "given_name":  "given_name",
        "family_name": "family_name",
        "picture":     "picture",
        "email":       "email",
        "locale":      "locale"
      },
      "idClaim": "sub",
      "verificationClaims": {
        "email": "email_verified"
      }
    }
  }
}
