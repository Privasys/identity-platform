{
    "cli": {
        "version": ">= 18.0.0",
        "appVersionSource": "remote",
        "promptToConfigurePushNotifications": true,
        "requireCommit": true
    },
    "build": {
        "base": { "node": "24.12.0", "bun": "1.3.11" },
        "development": {
            "extends": "preview",
            "developmentClient": true,
            "distribution": "internal",
            "ios": { "simulator": false }
        },
        "staging": { "extends": "production", "distribution": "internal" },
        "preview": {
            "extends": "base",
            "distribution": "store",
            "autoIncrement": true,
            "env": { "NODE_ENV": "development", "STAGE": "preview" }
        },
        "production": {
            "extends": "base",
            "distribution": "store",
            "autoIncrement": true,
            "env": {
                "NODE_ENV": "production",
                "STAGE": "production",
                "EXPO_PUBLIC_PLATFORM_API_URL": "https://api.developer.privasys.org",
                "EXPO_PUBLIC_KYC_VERIFIER_APP": "privasys-identity-verifier",
                "EXPO_PUBLIC_KYC_VERIFIER_ORIGIN": "privasys-identity-verifier.apps.privasys.org",
                "EXPO_PUBLIC_KYC_VERIFIER_DIGEST": "c3be34907de11b13031d7dbe0b3a3122a45bcc304062c3d890ce7e81f1558123",
                "EXPO_PUBLIC_DRIVE_APP": "privasys-drive",
                "EXPO_PUBLIC_DRIVE_ORIGIN": "privasys-drive.apps.privasys.org",
                "EXPO_PUBLIC_DRIVE_DIGEST": "8d47008c46248a9503a754bafcd943e85e20006efaaf4eddbbd397fa3b604c73"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6761209489",
                "ascApiKeyId": "LK6XPT3RK2",
                "ascApiKeyIssuerId": "7b8de6b6-bda6-4fd6-a8e4-5f755fab8fea",
                "ascApiKeyPath": "../keys/AuthKey_LK6XPT3RK2.p8"
            },
            "android": {
                "serviceAccountKeyPath": "./google-play-key.json",
                "track": "internal"
            }
        }
    }
}
