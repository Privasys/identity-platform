# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
android/
ios/

# Un-ignore native module sources (expo config plugins + extension code)
!modules/**/ios/
!modules/**/android/

# ...but the un-ignore above also exposes local native build outputs — keep
# those ignored (CMake/Gradle/Kotlin caches generated by `expo run:android`).
modules/**/android/build/
modules/**/android/.cxx/
modules/**/android/.gradle/
modules/**/ios/build/

# Expo prebuild scaffolds a stray root entry we don't use (package `main` is
# `expo-router/entry`; this index.js imports a non-existent ./App).
/index.js

# Pre-built Rust binaries (downloaded during CI, never committed)
modules/native-ratls/ios/lib/
modules/native-ratls/android/src/main/jniLibs/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

