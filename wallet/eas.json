{
    "cli": {
        "version": ">= 18.0.0",
        "appVersionSource": "remote",
        "promptToConfigurePushNotifications": true,
        "requireCommit": true
    },
    "build": {
        "base": { "node": "24.12.0", "bun": "1.3.11" },
        "development": {
            "extends": "preview",
            "developmentClient": true,
            "distribution": "internal",
            "ios": { "simulator": false }
        },
        "staging": { "extends": "production", "distribution": "internal" },
        "preview": {
            "extends": "base",
            "distribution": "store",
            "autoIncrement": true,
            "env": { "NODE_ENV": "development", "STAGE": "preview" }
        },
        "production": {
            "extends": "base",
            "distribution": "store",
            "autoIncrement": true,
            "env": {
                "NODE_ENV": "production",
                "STAGE": "production",
                "EXPO_PUBLIC_PLATFORM_API_URL": "https://api.developer.privasys.org",
                "EXPO_PUBLIC_KYC_VERIFIER_APP": "privasys-identity-verifier",
                "EXPO_PUBLIC_KYC_VERIFIER_ORIGIN": "privasys-identity-verifier.apps.privasys.org",
                "EXPO_PUBLIC_KYC_VERIFIER_DIGEST": "8f8f55930c8e3f8a016fff5f179cdde419e6dbf0a1905fb4b7151c34589d988c",
                "EXPO_PUBLIC_DRIVE_APP": "privasys-drive",
                "EXPO_PUBLIC_DRIVE_ORIGIN": "privasys-drive.apps.privasys.org",
                "EXPO_PUBLIC_DRIVE_DIGEST": "8d47008c46248a9503a754bafcd943e85e20006efaaf4eddbbd397fa3b604c73"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6761209489",
                "ascApiKeyId": "9H3WFH5GZY",
                "ascApiKeyIssuerId": "187e7a6e-cbee-4599-8043-eb862a5bf2f9",
                "ascApiKeyPath": "../keys/AuthKey_9H3WFH5GZY.p8"
            },
            "android": {
                "serviceAccountKeyPath": "./google-play-key.json",
                "track": "internal"
            }
        }
    }
}
